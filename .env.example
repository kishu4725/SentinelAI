# Copy to .env and fill in. NEVER commit .env.

# --- Core ---
# SENTINEL_ENV=production makes the backend refuse to start with missing/insecure secrets.
SENTINEL_ENV=development

# JWT signing key. Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL:  postgresql+psycopg2://USER:PASSWORD@localhost:5433/sentinelai_db
# SQLite (zero install):  sqlite:///./database/sentinelai.db
DATABASE_URL=sqlite:///./database/sentinelai.db

# Password for the seeded "admin" account. Required when SENTINEL_ENV=production.
SOC_ADMIN_PASSWORD=

# Comma-separated list; leave empty for the localhost defaults (ports 5173/5174/3000).
SENTINEL_CORS_ORIGINS=

# --- Sensors (honeypots, cloud event producer) ---
# Shared secret sensors send as the X-API-Key header. If empty, /api/events/ingest rejects everything.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINEL_SENSOR_API_KEY=

# DEMO/TEST ONLY. true = a sensor-supplied details.risk_score overrides the ML score. Keep false.
SENTINEL_TRUST_CLIENT_RISK_SCORE=false

# URL sensors post to (used by the honeypots, the simulator and cloud/cloud_event_producer.py)
SENTINELAI_BACKEND_URL=http://127.0.0.1:8000

# --- Honeypots (only SENTINEL_SENSOR_*, SENTINELAI_BACKEND_URL and HONEYPOT_* are ever read by them) ---
HONEYPOT_HTTP_HOST=127.0.0.1
HONEYPOT_HTTP_PORT=8080
# DEMO ONLY: take the attacker IP from X-Forwarded-For so the simulator can look like many attackers.
# Spoofable: never enable on an internet-facing honeypot.
HONEYPOT_TRUST_XFF=false
# DEMO ONLY: give RFC 5737 test IPs fake cities so the attack map has dots. Events are marked geo_simulated.
HONEYPOT_DEMO_GEO=false
# Optional: city shown as the attack target
HONEYPOT_TARGET_CITY=

# --- Email (optional; registration OTP and password reset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=True
SMTP_SSL=False
